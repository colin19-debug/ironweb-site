# Server-side only. Set these in Netlify → Project configuration → Environment variables.
# Never commit real values. Never put them in /site or any browser code.
# Leave them unset for local development: the lead function then runs in stub mode
# (logs the lead, sends nothing, and the form tells the visitor nothing was sent).

# CRM Private Integration token. Mark as secret; fill Production only.
# (GHL_TOKEN is accepted as an older name for the same value.)
GHL_API_KEY=
# CRM sub-account (location) ID for IronWeb Digital's own account.
GHL_LOCATION_ID=
# Optional: create/update one open opportunity per inquiry in this pipeline + stage.
# Leave blank to let the CRM workflow create the opportunity instead (don't do both).
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional: API Version header. Defaults to "v3" (worked live in the Saltmarsh demo).
GHL_API_VERSION=

# Not secrets (set in src/data.mjs, then rebuild):
#   BOOKING.url        public discovery-call calendar link
#   HERO_VIDEO.sources hero video files once supplied

# ---- Contractor Core interactive demo (/contractor-demo/) ----
# Every switch defaults OFF. With nothing set, the demo runs in PREVIEW mode: no CRM calls, simulated events.
# true = find/create the demo contact (existing contacts are not renamed), apply tag iw-contractor-demo FIRST,
# add a consent note, and create the New Lead opportunity in the demo pipeline (reusing an open one).
CONTRACTOR_DEMO_LIVE=
# true = ALSO add "new lead - website" (starts the Contractor Core intake workflow). Only when the visitor
# gave SMS consent. Requires CONTRACTOR_DEMO_LIVE=true. Turn on only after the demo workflows are isolated.
CONTRACTOR_DEMO_TRIGGER_WORKFLOWS=
# Optional overrides. Default pipeline: z39DlXlHDKhSdPpo4FUz ("IronWeb Contractor Demo"). Stage: looked up by
# name "New Lead" once and cached if blank.
CONTRACTOR_DEMO_PIPELINE_ID=
CONTRACTOR_DEMO_NEW_LEAD_STAGE_ID=
# AI receptionist: the number is never shown unless ENABLED=true AND the number is valid E.164 (+1XXXXXXXXXX).
CONTRACTOR_DEMO_RECEPTIONIST_ENABLED=
CONTRACTOR_DEMO_RECEPTIONIST_NUMBER=
# Optional: IronWeb's own sales booking page for "Book Your IronWeb Consultation" (https only).
# Blank = /contact/#book. Never the demo business's estimate calendar.
CONTRACTOR_DEMO_BOOKING_URL=
